# ==========================================================================
# MR. INFORMER BLOG - ENVIRONMENT CONFIGURATION TEMPLATE
# (Copy to .env locally, and set the same names as GitHub Actions secrets/
# variables in your repo settings for CI.)
# ==========================================================================

# Supabase Database Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key: Python ingestion scripts only. NEVER put this in
# supabase_client.js or any other file shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Public site domain, used for canonical URLs, sitemap.xml, and Open Graph
# tags. Update this once you've registered a domain, then re-run
# generate_seo_pages.py (or just let the next scheduled workflow run do it).
SITE_DOMAIN=https://mr-informer.top

# Optional: Anthropic API key for LLM-generated "Why this matters" editorial
# context on new articles (see llm_enrichment.py). Strictly optional — if
# unset, articles publish exactly as before (template-only, no fabrication).
# Get a key at https://console.anthropic.com/. Also needs to be added as a
# GitHub Actions repo secret (ANTHROPIC_API_KEY) for the automated pipeline.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Automated RSS Ingestion Sweeper Settings
# 10800 = 3 hours. Only used by scheduler.py for local/manual runs — the
# GitHub Actions cron schedule (.github/workflows/rss_ingestion.yml) is what
# actually controls production cadence.
RSS_SWEEP_INTERVAL=10800

# ==========================================================================
# NOTE on the admin CMS dashboard (index.html "#admin" panel):
# There is no admin password here anymore. Admin access is a real Supabase
# Auth login (email + password), created once in the Supabase dashboard
# under Authentication, with the resulting user ID added to the `admins`
# table (see supabase_schema.sql). Nothing admin-related belongs in this
# file or in any file shipped to the browser.
# ==========================================================================
