# ==========================================================================
# MR. INFORMER BLOG - ENVIRONMENT CONFIGURATION TEMPLATE
# (Copy to .env and fill in your private credentials)
# ==========================================================================

# Master Admin Access Key Password for CMS Dashboard
ADMIN_PASSWORD=your_secure_admin_password_here

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0

# Secret Session Key for Token Verification
SECRET_KEY=your_secret_session_token_here

# Automated Ingestion Sweeper Settings
RSS_SWEEP_INTERVAL=300
MAX_INGEST_PER_SWEEP=5
